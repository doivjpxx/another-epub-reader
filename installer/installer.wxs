<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <Product Id="*"
           Name="Another Epub Reader"
           Language="1033"
           Version="$(var.Version)"
           Manufacturer="Another Epub Reader"
           UpgradeCode="A7EE0CA4-7862-4C36-894E-67B210E506F4">
    <Package InstallerVersion="500"
             Compressed="yes"
             InstallScope="perMachine"
             Platform="x64" />

    <MajorUpgrade DowngradeErrorMessage="A newer version of Another Epub Reader is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <!-- ARPNOMODIFY must not be declared here: WixUI_Minimal (WixUIExtension, referenced below)
         already sets it, and declaring it twice makes light.exe fail with
         "LGHT0091: Duplicate symbol 'Property:ARPNOMODIFY'". ARPNOREPAIR is ours to set. -->
    <Property Id="ARPNOREPAIR" Value="1" />

    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="ProgramFiles64Folder">
        <Directory Id="INSTALLFOLDER" Name="Another Epub Reader">
          <!-- Win64="yes" is required: the package is built with Platform="x64" and the component
               lives under ProgramFiles64Folder, so it must be flagged as a 64-bit component.
               Without it, light.exe reports ICE80: "This 32BitComponent MainExecutable uses
               64BitDirectory INSTALLFOLDER". -->
          <Component Id="MainExecutable" Guid="53D6739F-250D-4F2D-BCE7-3C0FBC5C4FE8" Win64="yes">
            <File Id="AnotherEpubReaderExe"
                  Source="$(var.RepoRoot)\target\release\another-epub-reader.exe"
                  KeyPath="yes" />
            <File Id="ReadmeFile" Source="$(var.RepoRoot)\README.md" />
            <File Id="LicenseFile" Source="$(var.RepoRoot)\LICENSE" />
          </Component>
        </Directory>
      </Directory>

      <Directory Id="ProgramMenuFolder">
        <Directory Id="ProgramMenuDir" Name="Another Epub Reader">
          <!-- The Start Menu shortcut lives in its own component whose directory is
               ProgramMenuDir. That component owns the folder, so it can declare RemoveFolder
               (ICE64: a package-created directory in the user profile must be removed on
               uninstall) and it has a registry keypath instead of a file keypath
               (ICE43: non-advertised shortcuts must use a HKCU registry keypath). -->
          <Component Id="ApplicationShortcut" Guid="1A835846-8D3B-4C06-83F7-78820886DA61">
            <Shortcut Id="ApplicationStartMenuShortcut"
                      Name="Another Epub Reader"
                      Description="Another Epub Reader"
                      Target="[INSTALLFOLDER]another-epub-reader.exe"
                      WorkingDirectory="INSTALLFOLDER" />
            <RemoveFolder Id="RemoveProgramMenuDir" On="uninstall" />
            <RegistryValue Root="HKCU"
                           Key="Software\AnotherEpubReader\Install"
                           Name="ApplicationShortcut"
                           Type="integer"
                           Value="1"
                           KeyPath="yes" />
          </Component>
        </Directory>
      </Directory>
    </Directory>

    <Feature Id="MainFeature" Title="Another Epub Reader" Level="1">
      <ComponentRef Id="MainExecutable" />
      <ComponentRef Id="ApplicationShortcut" />
    </Feature>

    <UIRef Id="WixUI_Minimal" />
  </Product>
</Wix>
